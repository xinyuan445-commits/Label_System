page {
  height: 100%;
}

.login-page {
  min-height: 100vh;
  padding: 12vh 40rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 100% 0%, rgba(53, 116, 210, 0.2), transparent 40%),
    linear-gradient(180deg, #edf4fd 0%, #f7f9fc 52%, #eef2f7 100%);
}

.brand {
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto 56rpx;
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 92rpx;
  height: 92rpx;
  margin-right: 24rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2368c4;
  box-shadow: 0 14rpx 32rpx rgba(35, 104, 196, 0.24);
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
}

.brand-title {
  color: #17365d;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.brand-subtitle {
  margin-top: 8rpx;
  color: #6f7f93;
  font-size: 26rpx;
}

.login-card {
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
  padding: 44rpx 38rpx 40rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(26, 70, 122, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 20rpx 60rpx rgba(24, 54, 91, 0.12);
}

.card-title {
  margin-bottom: 36rpx;
  color: #17233d;
  font-size: 34rpx;
  font-weight: 650;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #42526a;
  font-size: 28rpx;
  font-weight: 500;
}

.field-input {
  width: 100%;
  height: 92rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #d9e2ef;
  border-radius: 16rpx;
  background: #ffffff;
  color: #17233d;
  font-size: 30rpx;
}

.error-message {
  min-height: 40rpx;
  margin: -4rpx 0 18rpx;
  color: #c53d3d;
  font-size: 26rpx;
  line-height: 40rpx;
}

.login-button {
  width: 100%;
  height: 96rpx;
  border-radius: 16rpx;
  background: #2368c4;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 96rpx;
}

.login-button[disabled] {
  background: #8db3e2;
  color: rgba(255, 255, 255, 0.9);
}

@media (min-width: 800px) {
  .login-page {
    padding-top: 9vh;
  }

  .brand,
  .login-card {
    max-width: 560px;
  }
}
