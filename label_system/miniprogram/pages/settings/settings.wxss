page {
  height: 100%;
}

.settings-page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: #f3f6fa;
}

.page-title {
  margin: 8rpx 0 30rpx;
  color: #17365d;
  font-size: 42rpx;
  font-weight: 700;
}

.address-card {
  display: block;
  margin-bottom: 22rpx;
  padding: 26rpx;
  border: 2rpx solid #dce5f0;
  border-radius: 22rpx;
  background: #ffffff;
}

.address-card.selected {
  border-color: #2368c4;
  box-shadow: 0 10rpx 28rpx rgba(35, 104, 196, 0.12);
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  color: #24344d;
  font-size: 30rpx;
  font-weight: 650;
}

.address-input {
  width: 100%;
  height: 82rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 2rpx solid #d9e2ef;
  border-radius: 14rpx;
  background: #f9fbfd;
  color: #17233d;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 27rpx;
}

.error-message {
  min-height: 42rpx;
  margin: 4rpx 0 14rpx;
  color: #c53d3d;
  font-size: 26rpx;
}

.open-button {
  height: 92rpx;
  border-radius: 16rpx;
  background: #2368c4;
  font-size: 31rpx;
  font-weight: 650;
  line-height: 92rpx;
}
