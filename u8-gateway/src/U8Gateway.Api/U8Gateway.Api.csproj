<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>U8Gateway.Api</AssemblyName>
    <RootNamespace>U8Gateway.Api</RootNamespace>
    <Version>0.3.7</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\U8Gateway.Contracts\U8Gateway.Contracts.csproj" />
    <ProjectReference Include="..\U8Gateway.Core\U8Gateway.Core.csproj" />
    <ProjectReference Include="..\U8Gateway.Metadata\U8Gateway.Metadata.csproj" />
    <ProjectReference Include="..\U8Gateway.Persistence\U8Gateway.Persistence.csproj" />
    <ProjectReference Include="..\U8Gateway.U8\U8Gateway.U8.csproj" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.2.9" />
    <PackageReference Include="Microsoft.AspNet.WebApi.WebHost" Version="5.2.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Global.asax" CopyToOutputDirectory="Never" />
    <Content Include="Web.config" CopyToOutputDirectory="Never" />
    <Content Include="Admin\index.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- ADODB is a runtime dependency of the typed purchase voucher adapter and
         is not copied transitively by MSBuild from U8Gateway.U8. -->
    <Content Include="..\..\lib\u8-interop\ADODB.dll" Link="ADODB.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
