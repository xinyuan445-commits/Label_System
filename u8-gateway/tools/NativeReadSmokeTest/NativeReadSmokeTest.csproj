<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>U8Gateway.NativeReadSmokeTest</AssemblyName>
    <RootNamespace>U8Gateway.NativeReadSmokeTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\U8Gateway.Contracts\U8Gateway.Contracts.csproj" />
    <ProjectReference Include="..\..\src\U8Gateway.Core\U8Gateway.Core.csproj" />
    <ProjectReference Include="..\..\src\U8Gateway.Metadata\U8Gateway.Metadata.csproj" />
    <ProjectReference Include="..\..\src\U8Gateway.U8\U8Gateway.U8.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADODB is consumed through a typed COM interop signature. MSBuild does not
         propagate it through the project reference, so keep an explicit runtime copy. -->
    <None Include="..\..\lib\u8-interop\ADODB.dll" Link="ADODB.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
